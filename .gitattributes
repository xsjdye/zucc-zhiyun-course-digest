# 统一换行符：仓库内一律用 LF，避免 Windows 同学 clone 后
# 出现整文件 CRLF 差异、或 git status 一直显示"已修改"
* text=auto eol=lf

*.md   text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf

# PowerShell 脚本用 CRLF（Windows 记事本与部分执行策略更稳）
*.ps1  text eol=crlf

# 二进制：不做换行转换、不尝试文本 diff
*.wav  binary
*.mp3  binary
*.m4a  binary
*.aac  binary
*.mp4  binary
*.mkv  binary
*.pptx binary
*.ppt  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ggml binary
*.pt   binary
*.bin  binary
*.onnx binary

# 语言与统计：文档目录不计入代码占比
docs/**  linguist-documentation
examples/** linguist-documentation
